# Local PostgreSQL (default in config.ts)
DATABASE_URL=postgresql://loveai:loveai_pw@localhost:5432/loveai
PORT=3001

# CORS: comma-separated frontend origin(s) allowed in production.
# Leave EMPTY for local dev (allows any origin, e.g. Vite :5173).
# Before deployment, set the real frontend URL(s):
#   ALLOWED_ORIGINS=https://loveai.example.com,https://loveai.vercel.app
#ALLOWED_ORIGINS=

# LLM inference endpoint. Two options:
#  A) Gemini (recommended): LLM_URL + LLM_CHAT_PATH + LLM_MODEL + LLM_API_KEY.
#  B) Self-hosted fine-tuned model (ml/serve.py): LLM_URL=http://localhost:8000 (default path /v1/chat/completions).
# Gemini OpenAI-compat base:
#   LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_CHAT_PATH=/chat/completions
#   LLM_MODEL=gemini-3.6-flash
LLM_URL=http://localhost:8000
LLM_CHAT_PATH=
LLM_MODEL=
LLM_API_KEY=
LLM_ENABLED=false
LLM_MOCK=true
LLM_TIMEOUT_MS=60000

# Persona vector projection
PERSONA_SEED=42

# RAG retrieval
RAG_LIMIT=5
RAG_MIN_SIMILARITY=0.25

# Auth (Google ID token)
# Session lifetime in days (default 30).
AUTH_SESSION_TTL_DAYS=30
# Dev-only: when true, accepts idToken "dev:<email>" without calling Google.
# NEVER enable in production.
AUTH_ALLOW_DEV_TOKEN=false
