{
  "name": "loveai-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/models',{recursive:true});require('fs').copyFileSync('src/models/schema.sql','dist/models/schema.sql')\"",
    "start": "node dist/index.js",
    "seed": "ts-node-dev --transpile-only --exit-child src/scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pgvector": "^0.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.21.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
