###############################################################################
# Copy to terraform.tfvars and edit. Do not commit secrets — there are none here:
# the API key is generated on the instance at boot.
###############################################################################
# cp terraform.tfvars.example terraform.tfvars

region      = "us-east-1"
name_prefix = "loveai-persona"

# --- instance -----------------------------------------------------------------
# t4g.small is free for 750 h/month through 2026-12-31 and serves the Q4_K_M GGUF
# comfortably (2 vCPU / 2 GiB). Switch to t4g.medium + the container path if you
# want the unquantized safetensors model.
instance_type          = "t4g.small"
instance_architecture  = "arm64"
root_volume_gb         = 16
cpu_credits            = "unlimited"   # "standard" = hard $0 ceiling, throttles instead
swap_gb                = 2

# --- access -------------------------------------------------------------------
# Either restrict SSH to your own address, or leave empty and use SSM Session
# Manager (aws ssm start-session). Never 0.0.0.0/0.
ssh_cidr        = ""                   # e.g. "203.0.113.7/32"
public_key_path = ""                   # e.g. "~/.ssh/id_ed25519.pub"
key_name        = ""

# --- public endpoint ----------------------------------------------------------
api_host          = "api.loveai.damnankur.com"
letsencrypt_email = ""                 # e.g. "ankur@example.com" — empty disables TLS

# --- model weights ------------------------------------------------------------
# 1) Create the bucket:            apply with create_model_bucket = true, then:
#      aws s3 cp persona-q4_k_m.gguf s3://<model_bucket>/models/persona/
# 2) Or reuse an existing bucket:  create_model_bucket = false ; model_bucket = "..."
model_source       = "s3"
create_model_bucket = true
model_bucket_name  = ""                # empty = loveai-persona-models-<account id>
model_prefix       = "models/persona"
model_file         = "persona-q4_k_m.gguf"
# model_source = "hf"
# hf_repo      = "your-user/loveai-persona-gguf"
# hf_file      = "persona-q4_k_m.gguf"

# Deploy bundle (helper scripts + systemd units + nginx confs). Build and upload
# BEFORE apply — see DEPLOYMENT_PLAYBOOK.md §3:
#   tar czf loveai-deploy.tar.gz -C ml/aws bin nginx systemd
#   aws s3 cp loveai-deploy.tar.gz s3://<model_bucket>/deploy/loveai-deploy.tar.gz
deploy_bundle_uri = ""                 # e.g. "s3://loveai-persona-models-123456789012/deploy/loveai-deploy.tar.gz"

# --- serving knobs ------------------------------------------------------------
llm_model   = "loveai-persona-1b"
ctx_size    = 6144
n_parallel  = 2
n_threads   = 0                        # 0 = nproc
llama_cpp_version = "b10941"           # pinned llama.cpp release (bump deliberately)

# --- guard rails --------------------------------------------------------------
alarm_email                 = ""       # e.g. "ankur@example.com" (alarms + $5 budget)
monthly_budget_usd          = 5
cpu_credit_alarm_threshold  = 40
