{
  "name": "loveai",
  "version": "1.0.0",
  "private": true,
  "description": "Fine-tuned LLM Persona Chatbot",
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "ml:data": "cd ml && .venv\\Scripts\\python.exe datasets\\build_dataset.py --n 200",
    "ml:train": "cd ml && .venv\\Scripts\\python.exe train.py",
    "ml:dpo": "cd ml && .venv\\Scripts\\python.exe train_dpo.py",
    "ml:serve": "cd ml && .venv\\Scripts\\python.exe serve.py"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
